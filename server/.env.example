# ── PostgreSQL Connection ──────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_password_here
PG_DATABASE=seadrone

# ── JWT ───────────────────────────────────────────────────────────────────────
# Required. Generate a random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── Detection (optional) ─────────────────────────────────────────────────────
# Python executable used to run detect/detect.py (default: python on Windows, python3 elsewhere)
# PYTHON_BIN=python
# Kill a detection run after this many milliseconds (default: 30 minutes)
# DETECT_TIMEOUT_MS=1800000
