# ── PostgreSQL Connection ──────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_password_here
PG_DATABASE=seadrone

# ── JWT ───────────────────────────────────────────────────────────────────────
# Required. Generate a random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# ── Default accounts (only used when the users table is empty) ───────────────
# Without ADMIN_PASSWORD a random admin password is generated and printed once in the log.
# ADMIN_PASSWORD=
# Set to also create a demo account "user1"
# DEMO_USER_PASSWORD=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── Detection (optional) ─────────────────────────────────────────────────────
# Python executable used to run detect/detect.py (default: python on Windows, python3 elsewhere)
# PYTHON_BIN=python
# Kill a detection run after this many milliseconds (default: 30 minutes)
# DETECT_TIMEOUT_MS=1800000

# ── Alerts (optional) ────────────────────────────────────────────────────────
# Detection labels that raise an alert, and the minimum confidence (0–1)
# ALERT_LABELS=drowning,drown,person_distress,swimmer,person
# ALERT_MIN_CONFIDENCE=0.60
